# Canonical production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.krishnaneuropsychiatric.com

# Optional analytics. Loaded only after the visitor gives consent.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Optional secure appointment webhook (CRM, automation, or serverless inbox).
# The public form always retains a no-data WhatsApp fallback.
APPOINTMENT_WEBHOOK_URL=
APPOINTMENT_WEBHOOK_SECRET=

# Optional verified Google review information. Leave blank until sourced
# directly from the clinic's Google Business Profile.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=
