# REQUIRED IN PRODUCTION. Current verified deployment URL, without a trailing slash.
# Change this one value after connecting a custom HTTPS domain; canonical URLs,
# sitemap, robots, Open Graph and structured data will update automatically.
NEXT_PUBLIC_SITE_URL=https://drkrishnadas.netlify.app

# Optional webmaster verification tokens. Paste only the token value, not the
# full meta tag. Leave blank until the relevant account is verified.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional analytics. Loaded only after the visitor gives consent.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Optional secure appointment webhook (CRM, automation, or serverless inbox).
# Without a webhook, the public form uses a no-storage WhatsApp fallback.
APPOINTMENT_WEBHOOK_URL=
APPOINTMENT_WEBHOOK_SECRET=

# Optional verified Google information. Leave blank until confirmed directly
# from the clinic's Google Business Profile.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=
