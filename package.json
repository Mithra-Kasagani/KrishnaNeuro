{
  "name": "krishna-neuro-psychiatric-centre",
  "version": "1.0.0",
  "private": true,
  "description": "Premium, accessible mental healthcare website for Dr. Pamarthi Krishna Das in Vijayawada.",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/validate-production-env.mjs && node scripts/validate-static-seo.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seo:validate": "node scripts/validate-static-seo.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@next/third-parties": "^16.3.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-icons": "^5.5.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
